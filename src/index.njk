---
layout: layouts/base.njk
bodyClass: home
---
{% set visitedCount = collections.visited | length %}
{% set total = world | length %}
{% set latest = collections.stories | limit(4) %}
<section class="wrap home-top">
  <div class="bento">
    <div class="hero reveal">
      {% if site.hero_image %}<div class="hero-bg" style="background-image:url('{{ site.hero_image | url }}')"></div>{% endif %}
      <div class="hero-shade"></div>
      <div class="hero-inner">
        <div class="script hero-kicker">{{ site.hero_kicker }}</div>
        <h1 class="hero-title">{{ site.title }}</h1>
        <p class="hero-text">{{ site.hero_text }}</p>
        <div class="hero-actions">
          <a class="btn" href="/stories/">Read the stories</a>
          <a class="btn btn-light" href="/map/">See the map</a>
        </div>
      </div>
    </div>

    <a class="tile tile-dark reveal" href="/countries/">
      <div class="caps">Countries visited</div>
      <div class="tile-row">
        <div class="count-big">{{ visitedCount }}<small>/{{ total }}</small></div>
        {% set circ = 2 * 3.14159 * 40 %}
        <svg class="ring" viewBox="0 0 92 92" aria-hidden="true"><circle class="bg" cx="46" cy="46" r="40"/><circle class="fg" cx="46" cy="46" r="40" stroke-dasharray="{{ circ }}" stroke-dashoffset="{{ circ }}" data-ring="{{ circ - circ * visitedCount / total }}"/></svg>
      </div>
    </a>

    {% if latest | length %}
      {% set s = latest[0] %}
      <a class="tile tile-peach reveal" href="{{ s.url }}">
        <div class="caps">Latest story</div>
        <div class="tile-row">
          <div><h3>{{ s.data.title }}</h3><p>{{ s.date | readableDate }}</p></div>
          <span class="arrow">→</span>
        </div>
      </a>
    {% else %}
      <a class="tile tile-peach reveal" href="/about/">
        <div class="caps">Hello there</div>
        <div class="tile-row">
          <div><h3>The first story is on its way</h3><p>Meet the traveller</p></div>
          <span class="arrow">→</span>
        </div>
      </a>
    {% endif %}
  </div>
</section>

<section class="section wrap">
  <div class="section-head reveal">
    <div>
      <div class="script kicker">fresh from the road</div>
      <h2>Latest stories</h2>
    </div>
    <a class="link-caps" href="/stories/">All stories →</a>
  </div>
  {% if latest | length %}
    <div class="story-grid featured">
      {% for story in latest %}<div class="reveal">{% include "partials/story-card.njk" %}</div>{% endfor %}
    </div>
  {% else %}
    <div class="empty reveal">The first story is still being written. Check back soon!</div>
  {% endif %}
</section>

<section class="section wrap">
  <div class="map-card dark reveal">
    <div class="map-head">
      <div><div class="script kicker" style="color:var(--peach)">where I've been</div><h3>The map so far</h3></div>
      <a class="btn btn-light" href="/map/">Open the map</a>
    </div>
    <div id="world-map" class="world-map small" data-theme="dark"></div>
  </div>
</section>

{% set feat = collections.visited | featured %}
<section class="section wrap">
  <div class="section-head reveal">
    <div>
      <div class="script kicker">passport stamps</div>
      <h2>Featured countries</h2>
    </div>
    <a class="link-caps" href="/countries/">All {{ total }} countries →</a>
  </div>
  {% if feat | length %}
    <div class="scroller reveal">
      {% for c in feat %}{% include "partials/country-card.njk" %}{% endfor %}
    </div>
  {% else %}
    <div class="empty reveal">No stamps yet — the journey is just starting.</div>
  {% endif %}
</section>

{% include "partials/map-script.njk" %}
