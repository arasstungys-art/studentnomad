---
layout: layouts/base.njk
bodyClass: home
---
{% set visitedCount = collections.visited | length %}
<section class="hero" {% if site.hero_image %}style="background-image:url('{{ site.hero_image | url }}')"{% endif %}>
  <div class="hero-shade"></div>
  <div class="wrap hero-inner">
    <div class="script hero-kicker">{{ site.hero_kicker }}</div>
    <h1 class="hero-title">{{ site.title }}</h1>
    <p class="hero-text">{{ site.hero_text }}</p>
    <a class="btn" href="/stories/">Read the stories</a>
    <div class="counter"><strong>{{ visitedCount }}</strong> of {{ world | length }} countries visited</div>
  </div>
</section>

<section class="section wrap">
  <div class="section-head">
    <div>
      <div class="script kicker">fresh from the road</div>
      <h2>Latest stories</h2>
    </div>
    <a class="link-caps" href="/stories/">All stories →</a>
  </div>
  {% set latest = collections.stories | limit(3) %}
  {% if latest | length %}
    <div class="story-grid">
      {% for story in latest %}{% include "partials/story-card.njk" %}{% endfor %}
    </div>
  {% else %}
    <div class="empty">The first story is still being written. Check back soon!</div>
  {% endif %}
</section>

<section class="section wrap map-teaser">
  <div>
    <div class="script kicker">where I've been</div>
    <h2>The map so far</h2>
    <p class="lead">Every orange patch is a country I've explored. Click one to open its profile.</p>
    <a class="btn btn-ghost" href="/map/">Open the map</a>
  </div>
  <div class="map-card"><div id="world-map" class="world-map small"></div></div>
</section>

<section class="section wrap">
  <div class="script kicker">passport stamps</div>
  <h2>Featured countries</h2>
  {% set feat = collections.visited | featured %}
  {% if feat | length %}
    <div class="country-grid">
      {% for c in feat %}{% include "partials/country-card.njk" %}{% endfor %}
    </div>
  {% else %}
    <div class="empty">No stamps yet — the journey is just starting. <a href="/countries/">See all {{ world | length }} countries.</a></div>
  {% endif %}
</section>

{% include "partials/map-script.njk" %}
