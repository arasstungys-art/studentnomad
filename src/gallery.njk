---
layout: layouts/base.njk
title: Gallery
permalink: /gallery/
---
{% set items = gallery.photos | galleryItems(collections.stories, collections.visited) %}
<section class="section wrap page-top">
  <div class="script kicker">snapshots</div>
  <h1 class="page-title">Gallery</h1>
  <p class="lead">Moments from the road.</p>
  {% if items | length %}
    <div class="gallery">
      {% for it in items %}
        <figure>
          <img src="{{ it.image }}" alt="{{ it.caption }}" loading="lazy" onerror="this.closest('figure').remove()">
          {% if it.caption %}<figcaption>{{ it.caption }}</figcaption>{% endif %}
        </figure>
      {% endfor %}
    </div>
      <div class="lightbox" id="lightbox" hidden><img alt=""></div>
  {% else %}
    <div class="empty">No photos yet — the camera roll is filling up.</div>
  {% endif %}
</section>
<script>
  {
    const lb = document.getElementById('lightbox');
    if (lb) {
      document.querySelectorAll('.gallery img').forEach((img) => img.addEventListener('click', () => { lb.querySelector('img').src = img.src; lb.hidden = false; }));
      lb.addEventListener('click', () => (lb.hidden = true));
      addEventListener('keydown', (e) => { if (e.key === 'Escape') lb.hidden = true; });
    }
  }
</script>
