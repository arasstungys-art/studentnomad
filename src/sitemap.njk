---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{% set base = "https://studentnomad.vercel.app" -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and not p.data.draft and p.url.endsWith('/') %}
  <url><loc>{{ base }}{{ p.url }}</loc><lastmod>{{ p.date | isoDate }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
