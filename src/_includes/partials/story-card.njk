<a class="story-card" href="{{ story.url }}">
  <div class="story-cover" {% if story.data.cover %}style="background-image:url('{{ story.data.cover | url }}')"{% endif %}>
    {% if story.data.country %}<span class="pill">{{ story.data.country | flag }} {{ story.data.country | countryName(world) }}</span>{% endif %}
  </div>
  <div class="story-body">
    <div class="meta">{{ story.date | readableDate }} · {{ story.content | readingTime }}</div>
    <h3>{{ story.data.title }}</h3>
    {% if story.data.excerpt %}<p>{{ story.data.excerpt }}</p>{% endif %}
  </div>
</a>
